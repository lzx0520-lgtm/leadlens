{
  "manifest_version": 3,
  "name": "线索透镜 LeadLens",
  "version": "0.1.0",
  "description": "把你在抖音 / 快手 / 小红书 / B站 上能看到的公开评论，汇总到本地工作台并自动筛出高意向线索。",
  "minimum_chrome_version": "116",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.douyin.com/*",
    "https://www.kuaishou.com/*",
    "https://www.xiaohongshu.com/*",
    "https://www.bilibili.com/*",
    "http://127.0.0.1:8787/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "线索透镜 LeadLens",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.douyin.com/*",
        "https://www.kuaishou.com/*",
        "https://www.xiaohongshu.com/*",
        "https://www.bilibili.com/*"
      ],
      "js": ["content/platforms.js", "content/core.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
